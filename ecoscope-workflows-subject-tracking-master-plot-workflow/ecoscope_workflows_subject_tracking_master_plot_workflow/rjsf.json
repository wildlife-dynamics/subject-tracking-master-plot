{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Set Workflow Details"
    },
    "er_connection": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to EarthRanger"
    },
    "subjects": {
      "additionalProperties": false,
      "properties": {
        "include_inactive": {
          "default": true,
          "title": "Include Inactive",
          "type": "boolean",
          "description": "Include inactive subjects in the list.",
          "ecoscope:advanced": true
        },
        "subject_group_name": {
          "title": "Subject Group",
          "description": "Check every subject on the site, or only the subjects in one group.",
          "default": null,
          "oneOf": [
            {
              "title": "All subject groups",
              "type": "null"
            },
            {
              "title": "One subject group",
              "type": "string",
              "ecoscope:transform": [
                {
                  "transformer": "EarthRangerEnumResolver",
                  "transformer_kws": {
                    "type": "subject_group_name",
                    "depends_on": "properties.er_connection.properties.data_source.properties.name"
                  }
                }
              ]
            }
          ]
        }
      },
      "required": [],
      "type": "object",
      "title": "Get Subjects"
    }
  },
  "$defs": {
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "subjects": {
      "ui:order": [
        "include_inactive",
        "subject_group_name"
      ]
    },
    "ui:order": [
      "workflow_details",
      "er_connection",
      "subjects"
    ]
  },
  "additionalProperties": false
}
